@{
    ViewData["Title"] = "Contact Us - Moon Essence";
}

<div class="contactPage">
    <!-- Hero Section with Premium Design -->
    <div class="heroSection contactHero">
        <div class="heroOverlay"></div>
        <div class="heroContent">
            <div class="heroBadge">Connect With Us</div>
            <h1 class="heroTitle">Get in <span class="highlight">Touch</span></h1>
            <p class="heroSubtitle">We'd love to hear from you and help with your fragrance journey</p>
            <br />
            <div class="heroScroll">
                <span>Reach Out</span>
                <div class="scrollIcon"></div>
            </div>
        </div>
    </div>

    <div class="contactContent">
        <div class="container">
            <div class="contactGrid">
                <!-- Contact Information Section -->
                <div class="contactInfo fadeInLeft">
                    <div class="sectionTag">Contact Info</div>
                    <h2 class="sectionTitle">Let's <span class="highlight">Connect</span></h2>
                    <p class="contactDesc">Have questions about our products, orders, or anything else? We're here to help you find your perfect scent!</p>

                    <div class="contactDetails">


                        <div class="contactItem">
                            <div class="contactIcon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                                    <circle cx="12" cy="10" r="3" />
                                </svg>
                            </div>
                            <div>
                                <h4>Visit Our Store</h4>
                                <p>Ichra, Lahore<br>Pakistan 54000</p>
                            </div>
                        </div>

                        <div class="contactItem">
                            <div class="contactIcon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
                                </svg>
                            </div>
                            <div>
                                <h4>Call Us</h4>
                                <p>+92 327 4574890</p>
                                <p>Mon-Fri, 9am - 6pm</p>
                            </div>
                        </div>

                        <div class="contactItem">
                            <div class="contactIcon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                                    <polyline points="22,6 12,13 2,6" />
                                </svg>
                            </div>
                            <div>
                                <h4>Email Us</h4>
                                <p>moonessenceinfo@gmail.com</p> 
                            </div>
                        </div>
                    </div>

                    <div class="businessHours">
                        <h3>Business Hours</h3>
                        <ul>
                            <li>
                                <span>Monday - Friday:</span>
                                <strong>9:00 AM - 6:00 PM</strong>
                            </li>
                            <li>
                                <span>Saturday:</span>
                                <strong>10:00 AM - 4:00 PM</strong>
                            </li>
                            <li>
                                <span>Sunday:</span>
                                <strong>Closed</strong>
                            </li>
                        </ul>
                    </div>

                    <div class="socialConnect">
                        <h4>Follow Us</h4>
                        <div class="socialLinks">
                            <a href="https://www.facebook.com/share/1B1bWLBHnX/" class="socialLink" aria-label="Facebook">
                                <i class="fa-brands fa-facebook"></i>
                            </a>
                            <a href="https://www.instagram.com/moon.essence_10?igsh=dHUxZTlqNjVtc2Nl" class="socialLink" aria-label="Instagram">
                                <i class="fa-brands fa-instagram"></i>
                            </a>
                            <a href="https://wa.me/923274574890?text=Hello%20I%20want%20to%20order" class="socialLink" aria-label="WhatsApp">
                                <i class="fa-brands fa-whatsapp"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Animate elements on scroll
        const animateOnScroll = () => {
            const elements = document.querySelectorAll('.contactItem, .businessHours, .socialConnect');
            elements.forEach(el => {
                const rect = el.getBoundingClientRect();
                if (rect.top < window.innerHeight - 100) {
                    el.classList.add('animate');
                }
            });
        };

        window.addEventListener('scroll', animateOnScroll);
        animateOnScroll();

        console.log("Contact Us page loaded");
    </script>
}

<style>
    /* Contact Page Styles - Dark Theme */
    .contactPage {
        background: #0a0a0a;
        overflow-x: hidden;
    }

    /* Hero Section */
    .contactHero {
        position: relative;
        background-image: linear-gradient(135deg, rgba(0, 0, 0, 0.5), rgba(255, 215, 0, 0.2)), url('/images/contact-hero.png');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        min-height: 60vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: white;
        position: relative;
        overflow: hidden;
    }

        .contactHero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: radial-gradient(circle at 30% 50%, rgba(255,215,0,0.15) 0%, transparent 60%);
            pointer-events: none;
        }

    .heroOverlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: radial-gradient(circle, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.5) 100%);
    }

    .heroContent {
        position: relative;
        z-index: 2;
        max-width: 800px;
        padding: 2rem;
        animation: fadeInUp 1s ease-out;
    }

    .heroBadge {
        display: inline-block;
        background: linear-gradient(135deg, #ffd700, #ff6b6b);
        padding: 0.5rem 1.5rem;
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        animation: pulse 2s infinite;
    }

    .heroTitle {
        font-size: 3.5rem;
        font-weight: 800;
        margin-bottom: 1rem;
    }

        .heroTitle .highlight {
            color: #ffd700;
        }

    .heroSubtitle {
        font-size: 1.1rem;
        opacity: 0.9;
        margin-bottom: 2rem;
    }

    .heroScroll {
        position: absolute;
        bottom: 30px;
        left: 50%;
        transform: translateX(-50%);
        text-align: center;
        font-size: 0.85rem;
        opacity: 0.8;
    }

    .scrollIcon {
        width: 20px;
        height: 30px;
        border: 2px solid #ffd700;
        border-radius: 15px;
        margin: 10px auto 0;
        position: relative;
    }

        .scrollIcon::before {
            content: '';
            position: absolute;
            width: 4px;
            height: 8px;
            background: #ffd700;
            left: 50%;
            transform: translateX(-50%);
            top: 5px;
            border-radius: 2px;
            animation: scroll 2s infinite;
        }

    /* Contact Content */
    .contactContent {
        padding: 5rem 0;
        background: #0a0a0a;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    /* Contact Grid */
    .contactGrid {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    /* Contact Info Section */
    .contactInfo {
        max-width: 800px;
        width: 100%;
        padding: 2.5rem;
        background: linear-gradient(135deg, #1a1a1a, #141414);
        border-radius: 20px;
        border: 1px solid #333;
        margin: 0 auto;
    }

    .sectionTag {
        display: inline-block;
        background: linear-gradient(135deg, #ffd70020, #ff6b6b20);
        color: #ff6b6b;
        padding: 0.3rem 1rem;
        border-radius: 50px;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 1rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .sectionTitle {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 1rem;
        color: #ffffff;
    }

        .sectionTitle .highlight {
            color: #ffd700;
        }

    .contactDesc {
        color: #aaa;
        margin-bottom: 2rem;
        line-height: 1.6;
    }

    /* Contact Items */
    .contactDetails {
        margin-bottom: 2rem;
    }

    .contactItem {
        display: flex;
        gap: 1rem;
        margin-bottom: 1.5rem;
        padding: 1rem;
        background: #0a0a0a;
        border-radius: 12px;
        transition: all 0.3s ease;
        border: 1px solid #333;
    }

        .contactItem:hover {
            transform: translateX(5px);
            border-color: #ffd700;
            background: linear-gradient(135deg, #1a1a1a, #0f0f0f);
        }

    .contactIcon {
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, #ffd70020, #ff6b6b20);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .contactIcon svg {
            width: 24px;
            height: 24px;
            color: #ffd700;
        }

    .contactItem h4 {
        color: #ffd700;
        margin-bottom: 0.5rem;
        font-size: 1rem;
    }

    .contactItem p {
        color: #ccc;
        margin: 0;
        line-height: 1.5;
        font-size: 0.9rem;
    }

    /* Business Hours */
    .businessHours {
        background: #0a0a0a;
        padding: 1.5rem;
        border-radius: 12px;
        margin: 2rem 0;
        border: 1px solid #333;
    }

        .businessHours h3 {
            color: #ffd700;
            margin-bottom: 1rem;
            font-size: 1.2rem;
        }

        .businessHours ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .businessHours li {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.75rem 0;
            border-bottom: 1px solid #333;
            color: #ccc;
        }

            .businessHours li:last-child {
                border-bottom: none;
            }

            .businessHours li span {
                font-weight: 500;
            }

            .businessHours li strong {
                color: #ffd700;
            }

    /* Social Connect */
    .socialConnect h4 {
        color: #ffd700;
        margin-bottom: 1rem;
        font-size: 1rem;
    }

    .socialConnect .socialLinks {
        display: flex;
        gap: 1rem;
    }

    .socialConnect .socialLink {
        width: 40px;
        height: 40px;
        background: #1a1a1a;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        border: 1px solid #333;
    }

        .socialConnect .socialLink:hover {
            background: linear-gradient(135deg, #ffd700, #ff6b6b);
            transform: translateY(-3px);
            border-color: transparent;
        }

        .socialConnect .socialLink svg {
            width: 20px;
            height: 20px;
            color: white;
        }

    /* Animations */
   @@keyframes fadeInUp {
        from

    {
        opacity: 0;
        transform: translateY(30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

   @@keyframes fadeInLeft {
        from

    {
        opacity: 0;
        transform: translateX(-30px);
    }

    to {
        opacity: 1;
        transform: translateX(0);
    }

    }

   @@keyframes fadeInRight {
        from

    {
        opacity: 0;
        transform: translateX(30px);
    }

    to {
        opacity: 1;
        transform: translateX(0);
    }

    }

   @@keyframes pulse {
        0%, 100%

    {
        transform: scale(1);
    }

    50% {
        transform: scale(1.05);
    }

    }

   @@keyframes scroll {
        0%

    {
        transform: translateX(-50%) translateY(0);
        opacity: 1;
    }

    100% {
        transform: translateX(-50%) translateY(15px);
        opacity: 0;
    }

    }

    .fadeInLeft {
        animation: fadeInLeft 0.8s ease-out;
    }

    .contactItem {
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.5s ease;
    }

        .contactItem.animate {
            opacity: 1;
            transform: translateY(0);
        }

    /* Responsive Design */
   @@media (max-width: 1024px) {
        .heroTitle

    {
        font-size: 2.5rem;
    }

    }

   @@media (max-width: 768px) {
        .contactHero

    {
        background-attachment: scroll;
        min-height: 50vh;
    }

    .heroTitle {
        font-size: 2rem;
    }

    .heroSubtitle {
        font-size: 1rem;
    }

    .sectionTitle {
        font-size: 1.5rem;
    }

    .businessHours li {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.25rem;
    }

    .contactItem {
        padding: 0.75rem;
    }

    .contactIcon {
        width: 40px;
        height: 40px;
    }

        .contactIcon svg {
            width: 20px;
            height: 20px;
        }

    .contactInfo {
        padding: 1.5rem;
    }

    }

   @@media (max-width: 480px) {
        .container

    {
        padding: 0 1rem;
    }

    .heroTitle {
        font-size: 1.8rem;
    }

    .heroBadge {
        font-size: 0.75rem;
        padding: 0.3rem 1rem;
    }

    .contactInfo {
        padding: 1.5rem;
    }

    .contactItem {
        flex-direction: column;
        text-align: center;
    }

    .contactIcon {
        margin: 0 auto;
    }

    .businessHours li {
        text-align: center;
        align-items: center;
    }

    .socialConnect .socialLinks {
        justify-content: center;
    }

    }
</style>