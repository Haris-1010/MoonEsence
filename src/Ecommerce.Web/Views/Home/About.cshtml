@{
    ViewData["Title"] = "About Us - Moon Essence";
}

<div class="aboutPage">
    <!-- Hero Section -->
    <div class="heroSection aboutHero">
        <div class="heroOverlay"></div>
        <div class="heroContent">
            <div class="heroBadge">Since 2020</div>
            <h1 class="heroTitle animate-text">Our Story</h1>
            <p class="heroSubtitle animate-text-delay">Crafting timeless fragrances that tell your story</p>
            <br />
            <div class="heroScroll">
                <span>Discover Our Journey</span>
                <div class="scrollIcon"></div>
            </div>
        </div>
    </div>

    <div class="aboutContent">
        <div class="container">
            <!-- About Section -->
            <div class="aboutGrid">
                <div class="aboutText fadeInLeft">
                    <div class="sectionTag">Who We Are</div>
                    <h2 class="sectionTitle">The Essence of <span class="highlight">Moon Essence</span></h2>
                    <div class="aboutDesc">
                        <p>At Moon Essence, we believe that fragrance is more than just a scent—it's a memory, a feeling, an experience. Our journey began with a simple passion for traditional attars and a desire to share the rich heritage of oriental perfumery with the world.</p>

                        <div class="quoteBox">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M10 11h-4v-4h4v4zm8 0h-4v-4h4v4zm-8 8h-4v-4h4v4zm8 0h-4v-4h4v4z" />
                            </svg>
                            <p>Fragrance is the art that speaks to the soul without words</p>
                        </div>

                        <p>We meticulously source the finest ingredients from around the globe, combining ancient techniques with modern innovation to create fragrances that are both timeless and contemporary. Each attar is carefully crafted to evoke emotions, inspire confidence, and leave a lasting impression.</p>

                        <div class="philosophyBox">
                            <h3>Our Philosophy</h3>
                            <p>Quality, authenticity, and customer satisfaction are at the heart of everything we do. We believe in creating products that are not only luxurious but also accessible, allowing everyone to experience the magic of premium fragrances.</p>
                        </div>
                    </div>
                </div>

                <div class="aboutImage fadeInRight">
                    <div class="imageWrapper">
                        <img src="/images/attar-crafting.jpg" alt="Traditional Attar Making" onerror="this.src='/images/attar-placeholder.jpg'" />
                        <div class="imageOverlay">
                            <div class="experienceBadge">
                                <span class="years">5+</span>
                                <span class="text">Years of Excellence</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Values Section -->
            <div class="valuesSection">
                <div class="sectionHeader">
                    <div class="sectionTag">Core Values</div>
                    <h2 class="sectionTitle">What Drives <span class="highlight">Us Forward</span></h2>
                    <p class="sectionDesc">These principles guide everything we do at Moon Essence</p>
                </div>
                <div class="valuesGrid">
                    <div class="valueCard stagger-item">
                        <div class="valueIcon">🌿</div>
                        <h3>Natural Ingredients</h3>
                        <p>We use only the finest natural ingredients, ethically sourced from trusted suppliers around the world.</p>
                        <div class="cardHover"></div>
                    </div>
                    <div class="valueCard stagger-item">
                        <div class="valueIcon">✨</div>
                        <h3>Quality Craftsmanship</h3>
                        <p>Each attar is handcrafted with care and precision by skilled artisans who pour their passion into every bottle.</p>
                        <div class="cardHover"></div>
                    </div>
                    <div class="valueCard stagger-item">
                        <div class="valueIcon">💚</div>
                        <h3>Sustainable Practices</h3>
                        <p>We're committed to eco-friendly packaging and sustainable business practices for a better tomorrow.</p>
                        <div class="cardHover"></div>
                    </div>
                    <div class="valueCard stagger-item">
                        <div class="valueIcon">🤝</div>
                        <h3>Customer First</h3>
                        <p>Your satisfaction is our priority, from product quality to exceptional customer service experience.</p>
                        <div class="cardHover"></div>
                    </div>
                </div>
            </div>

            <!-- Stats Section -->
            <div class="statsSection">
                <div class="statsContainer">
                    <div class="statItem">
                        <div class="statNumber" data-count="5000">0</div>
                        <div class="statLabel">Happy Customers</div>
                        <div class="statIcon">😊</div>
                    </div>
                    <div class="statItem">
                        <div class="statNumber" data-count="100">0</div>
                        <div class="statLabel">Unique Fragrances</div>
                        <div class="statIcon">🌸</div>
                    </div>
                    <div class="statItem">
                        <div class="statNumber" data-count="50">0</div>
                        <div class="statLabel">Cities Served</div>
                        <div class="statIcon">🏙️</div>
                    </div>
                    <div class="statItem">
                        <div class="statNumber" data-count="4.9">0</div>
                        <div class="statLabel">Customer Rating</div>
                        <div class="statIcon">⭐</div>
                    </div>
                </div>
            </div>

            <!-- Journey Timeline -->
            <div class="timelineSection">
                <div class="sectionHeader">
                    <div class="sectionTag">Our Journey</div>
                    <h2 class="sectionTitle">The <span class="highlight">Moon Essence</span> Story</h2>
                    <p class="sectionDesc">A journey of passion, dedication, and timeless fragrances</p>
                </div>
                <div class="timeline">
                    <div class="timelineItem">
                        <div class="timelineYear">2020</div>
                        <div class="timelineContent">
                            <h3>The Beginning</h3>
                            <p>Moon Essence was founded with a vision to bring traditional attars to modern fragrance lovers.</p>
                        </div>
                    </div>
                    <div class="timelineItem">
                        <div class="timelineYear">2021</div>
                        <div class="timelineContent">
                            <h3>First Collection</h3>
                            <p>Launched our debut collection of 20 premium attars, receiving overwhelming response.</p>
                        </div>
                    </div>
                    <div class="timelineItem">
                        <div class="timelineYear">2022</div>
                        <div class="timelineContent">
                            <h3>Expansion</h3>
                            <p>Expanded to 5 cities and introduced sustainable packaging initiatives.</p>
                        </div>
                    </div>
                    <div class="timelineItem">
                        <div class="timelineYear">2023</div>
                        <div class="timelineContent">
                            <h3>Global Recognition</h3>
                            <p>Awarded "Best Artisanal Fragrance Brand" and reached 5000+ happy customers.</p>
                        </div>
                    </div>
                    <div class="timelineItem">
                        <div class="timelineYear">2024</div>
                        <div class="timelineContent">
                            <h3>Innovation</h3>
                            <p>Launched AI-powered fragrance recommendation system and expanded to 50+ cities.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CTA Section -->
            <div class="ctaSection">
                <div class="ctaContent">
                    <h2>Experience the Magic</h2>
                    <p>Discover our collection of premium attars and find your signature scent today.</p>
                    <div class="ctaButtons">
                        <a href="/" class="btn btnPrimary">Shop Now</a>
                        <a href="/Home/Contact" class="btn btnSecondary">Contact Us</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Animated counter for statistics
        function animateCounter(element, target, hasDecimal = false) {
            let current = 0;
            const increment = target / 50;
            const duration = 2000;
            const stepTime = duration / 50;

            const timer = setInterval(() => {
                if (hasDecimal) {
                    current += increment;
                    if (current >= target) {
                        element.textContent = target;
                        clearInterval(timer);
                    } else {
                        element.textContent = current.toFixed(1);
                    }
                } else {
                    current += increment;
                    if (current >= target) {
                        element.textContent = target;
                        clearInterval(timer);
                    } else {
                        element.textContent = Math.floor(current);
                    }
                }
            }, stepTime);
        }

        // Intersection Observer for stats animation
        const observerOptions = {
            threshold: 0.5,
            rootMargin: "0px"
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const statNumbers = entry.target.querySelectorAll('.statNumber');
                    statNumbers.forEach(stat => {
                        const target = parseFloat(stat.getAttribute('data-count'));
                        const hasDecimal = target % 1 !== 0;
                        animateCounter(stat, target, hasDecimal);
                    });
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        const statsSection = document.querySelector('.statsSection');
        if (statsSection) {
            observer.observe(statsSection);
        }

        // Staggered animation for value cards
        const valueCards = document.querySelectorAll('.valueCard');
        valueCards.forEach((card, index) => {
            card.style.animationDelay = `${index * 0.1}s`;
            card.classList.add('fadeInUp');
        });

        // Timeline items animation
        const timelineItems = document.querySelectorAll('.timelineItem');
        const timelineObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('animate');
                }
            });
        }, { threshold: 0.3 });

        timelineItems.forEach(item => timelineObserver.observe(item));

        // Parallax effect for hero section
        window.addEventListener('scroll', () => {
            const hero = document.querySelector('.aboutHero');
            const scrolled = window.pageYOffset;
            if (hero) {
                hero.style.transform = `translateY(${scrolled * 0.5}px)`;
            }
        });

        console.log("About Us page loaded with animations");
    </script>
}

<style>
    /* About Page Styles - Dark Theme */
    .aboutPage {
        background: #0a0a0a;
        overflow-x: hidden;
    }

    /* Hero Section */
    .aboutHero {
        position: relative;
        background-image: linear-gradient(135deg, rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.7)), url('/images/attar-hero.png');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: white;
        position: relative;
        overflow: hidden;
    }

    .heroOverlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: radial-gradient(circle, rgba(0,0,0,0.3) 0%, rgba(0,0,0,0.8) 100%);
    }

    .heroContent {
        position: relative;
        z-index: 2;
        max-width: 900px;
        padding: 2rem;
        animation: fadeInUp 1s ease-out;
    }

    .heroBadge {
        display: inline-block;
        background: linear-gradient(135deg, #ffd700, #ff6b6b);
        padding: 0.5rem 1.5rem;
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        animation: pulse 2s infinite;
    }

    .heroTitle {
        font-size: 4rem;
        font-weight: 800;
        margin-bottom: 1rem;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
    }

    .heroSubtitle {
        font-size: 1.2rem;
        opacity: 0.95;
        margin-bottom: 2rem;
    }

    .heroScroll {
        position: absolute;
        bottom: 30px;
        left: 50%;
        transform: translateX(-50%);
        text-align: center;
        font-size: 0.85rem;
        opacity: 0.8;
    }

    .scrollIcon {
        width: 20px;
        height: 30px;
        border: 2px solid white;
        border-radius: 15px;
        margin: 10px auto 0;
        position: relative;
    }

        .scrollIcon::before {
            content: '';
            position: absolute;
            width: 4px;
            height: 8px;
            background: white;
            left: 50%;
            transform: translateX(-50%);
            top: 5px;
            border-radius: 2px;
            animation: scroll 2s infinite;
        }

   @@keyframes scroll {
        0%

    {
        transform: translateX(-50%) translateY(0);
        opacity: 1;
    }

    100% {
        transform: translateX(-50%) translateY(15px);
        opacity: 0;
    }

    }

    /* Animations */
   @@keyframes fadeInUp {
        from

    {
        opacity: 0;
        transform: translateY(30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

   @@keyframes fadeInLeft {
        from

    {
        opacity: 0;
        transform: translateX(-30px);
    }

    to {
        opacity: 1;
        transform: translateX(0);
    }

    }

   @@keyframes fadeInRight {
        from

    {
        opacity: 0;
        transform: translateX(30px);
    }

    to {
        opacity: 1;
        transform: translateX(0);
    }

    }

   @@keyframes pulse {
        0%, 100%

    {
        transform: scale(1);
    }

    50% {
        transform: scale(1.05);
    }

    }

    .animate-text {
        animation: fadeInUp 0.6s ease-out;
    }

    .animate-text-delay {
        animation: fadeInUp 0.6s ease-out 0.2s both;
    }

    .fadeInLeft {
        animation: fadeInLeft 0.8s ease-out;
    }

    .fadeInRight {
        animation: fadeInRight 0.8s ease-out;
    }

    .fadeInUp {
        animation: fadeInUp 0.6s ease-out forwards;
        opacity: 0;
    }

    /* About Content */
    .aboutContent {
        padding: 5rem 0;
        background: #0a0a0a;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    /* Section Styles */
    .sectionTag {
        display: inline-block;
        background: linear-gradient(135deg, #ffd70020, #ff6b6b20);
        color: #ff6b6b;
        padding: 0.3rem 1rem;
        border-radius: 50px;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 1rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .sectionTitle {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
        color: #ffffff;
    }

    .highlight {
        color: #ff6b6b;
        position: relative;
        display: inline-block;
    }

        .highlight::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient(90deg, #ffd700, #ff6b6b);
            transform: scaleX(0);
            transition: transform 0.3s ease;
            transform-origin: left;
        }

    .sectionTitle:hover .highlight::after {
        transform: scaleX(1);
    }

    .sectionDesc {
        color: #aaa;
        font-size: 1.1rem;
        margin-bottom: 2rem;
    }

    /* About Grid */
    .aboutGrid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        margin-bottom: 5rem;
        align-items: center;
    }

    .aboutDesc p {
        color: #ccc;
        line-height: 1.8;
        margin-bottom: 1.5rem;
    }

    .quoteBox {
        background: linear-gradient(135deg, #1a1a1a, #141414);
        padding: 2rem;
        border-radius: 15px;
        margin: 2rem 0;
        position: relative;
        text-align: center;
        border: 1px solid #333;
    }

        .quoteBox svg {
            color: #ff6b6b;
            opacity: 0.3;
            position: absolute;
            top: -20px;
            left: 20px;
        }

        .quoteBox p {
            font-size: 1.2rem;
            font-style: italic;
            margin: 0;
            color: #ffd700;
        }

    .philosophyBox {
        background: linear-gradient(135deg, #1a1a1a, #141414);
        padding: 2rem;
        border-radius: 15px;
        border-left: 4px solid #ff6b6b;
    }

        .philosophyBox h3 {
            color: #ff6b6b;
            margin-bottom: 1rem;
        }

    /* About Image */
    .aboutImage {
        position: relative;
    }

    .imageWrapper {
        position: relative;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(0,0,0,0.3);
        transition: transform 0.3s ease;
    }

        .imageWrapper:hover {
            transform: scale(1.02);
        }

    .aboutImage img {
        width: 100%;
        height: auto;
        display: block;
        transition: transform 0.5s ease;
    }

    .imageWrapper:hover img {
        transform: scale(1.05);
    }

    .imageOverlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: linear-gradient(transparent, rgba(0,0,0,0.9));
        padding: 2rem;
    }

    .experienceBadge {
        display: inline-block;
        background: linear-gradient(135deg, #1a1a2e, #16213e);
        padding: 0.5rem 1rem;
        border-radius: 10px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        border: 1px solid #ffd700;
    }

        .experienceBadge .years {
            font-size: 1.5rem;
            font-weight: 700;
            color: #ffd700;
        }

        .experienceBadge .text {
            color: white;
            margin-left: 0.5rem;
        }

    /* Values Section */
    .valuesSection {
        margin: 5rem 0;
    }

    .valuesGrid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
    }

    .valueCard {
        background: linear-gradient(135deg, #1a1a1a, #141414);
        padding: 2rem;
        border-radius: 20px;
        text-align: center;
        position: relative;
        overflow: hidden;
        transition: all 0.3s ease;
        box-shadow: 0 5px 15px rgba(0,0,0,0.3);
        border: 1px solid #333;
    }

        .valueCard:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 30px rgba(0,0,0,0.5);
            border-color: #ff6b6b;
        }

    .valueIcon {
        font-size: 3rem;
        margin-bottom: 1rem;
        display: inline-block;
        transition: transform 0.3s ease;
    }

    .valueCard:hover .valueIcon {
        transform: scale(1.1) rotate(5deg);
    }

    .valueCard h3 {
        font-size: 1.3rem;
        margin-bottom: 1rem;
        color: #ffd700;
    }

    .valueCard p {
        color: #ccc;
        line-height: 1.6;
    }

    .cardHover {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #ffd70010, #ff6b6b10);
        transform: translateY(100%);
        transition: transform 0.3s ease;
    }

    .valueCard:hover .cardHover {
        transform: translateY(0);
    }

    /* Stats Section - Dark Theme */
    .statsSection {
        background: linear-gradient(135deg, #1a1a2e, #0f0f1a);
        border-radius: 30px;
        padding: 4rem 2rem;
        margin: 5rem 0;
        position: relative;
        overflow: hidden;
        border: 1px solid #ffd70020;
    }

        .statsSection::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,215,0,0.05) 1%, transparent 1%);
            background-size: 50px 50px;
            animation: moveGrid 20s linear infinite;
        }

   @@keyframes moveGrid {
        0%

    {
        transform: translate(0, 0);
    }

    100% {
        transform: translate(50px, 50px);
    }

    }

    .statsContainer {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 2rem;
        position: relative;
        z-index: 1;
    }

    .statItem {
        text-align: center;
        color: white;
        position: relative;
    }

    .statNumber {
        font-size: 3rem;
        font-weight: 800;
        display: block;
        margin-bottom: 0.5rem;
        background: linear-gradient(135deg, #ffd700, #ff6b6b);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: countUp 2s ease-out;
    }

    .statLabel {
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #ccc;
    }

    .statIcon {
        font-size: 2rem;
        margin-top: 0.5rem;
        opacity: 0.8;
    }

    /* Timeline Section */
    .timelineSection {
        margin: 5rem 0;
    }

    .timeline {
        position: relative;
        padding: 2rem 0;
    }

        .timeline::before {
            content: '';
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            width: 2px;
            height: 100%;
            background: linear-gradient(180deg, #ffd700, #ff6b6b, #ffd700);
        }

    .timelineItem {
        margin-bottom: 3rem;
        position: relative;
        opacity: 0;
        transform: translateY(30px);
        transition: all 0.6s ease;
    }

        .timelineItem.animate {
            opacity: 1;
            transform: translateY(0);
        }

        .timelineItem:nth-child(odd) {
            padding-right: calc(50% + 30px);
            text-align: right;
        }

        .timelineItem:nth-child(even) {
            padding-left: calc(50% + 30px);
        }

    .timelineYear {
        position: absolute;
        top: 0;
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #ffd700, #ff6b6b);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        color: #0a0a0a;
        font-size: 1rem;
        z-index: 2;
        box-shadow: 0 5px 15px rgba(0,0,0,0.3);
    }

    .timelineItem:nth-child(odd) .timelineYear {
        right: calc(50% - 40px);
    }

    .timelineItem:nth-child(even) .timelineYear {
        left: calc(50% - 40px);
    }

    .timelineContent {
        background: #1a1a1a;
        padding: 1.5rem;
        border-radius: 15px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.3);
        transition: transform 0.3s ease;
        border: 1px solid #333;
    }

        .timelineContent:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.4);
            border-color: #ff6b6b;
        }

        .timelineContent h3 {
            color: #ff6b6b;
            margin-bottom: 0.5rem;
        }

        .timelineContent p {
            color: #ccc;
            line-height: 1.6;
            margin: 0;
        }

