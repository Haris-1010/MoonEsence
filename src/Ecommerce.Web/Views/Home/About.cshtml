    .ctaSection {
        background: linear-gradient(135deg, #0a0a0a, #000000);
        border-radius: 30px;
        padding: 4rem 2rem;
        margin: 5rem 0;
        text-align: center;
        position: relative;
        overflow: hidden;
        border: 1px solid #ffd70020;
    }

        .ctaSection::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,215,0,0.05) 1%, transparent 1%);
            background-size: 50px 50px;
            animation: moveGrid 20s linear infinite;
        }

    .ctaContent {
        position: relative;
        z-index: 1;
    }

        .ctaContent h2 {
            font-size: 2.5rem;
            color: white;
            margin-bottom: 1rem;
        }

        .ctaContent p {
            color: #ccc;
            font-size: 1.1rem;
            margin-bottom: 2rem;
        }

    .ctaButtons {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn {
        display: inline-block;
        padding: 1rem 2rem;
        border-radius: 50px;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s ease;
