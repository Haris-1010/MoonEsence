@model Ecommerce.Web.ViewModels.HomeIndexViewModel
@{
    ViewData["Title"] = "Shop"; ViewData["PageType"] = "Home";
}

<section class="page">
    <div class="container">
        <div class="pageHeader">
            <h1 class="pageTitle">Shop</h1>
            <p class="pageSubtitle">Mobile-first shopping experience</p>
        </div>
         
        <div class="promo-banner panel">
            <div class="promo-inner">
                <div class="promo-left">
                    <div class="pill sale">-30%</div>
                    <h2 class="promo-title">Spring Collection — Moon Essence</h2>
                    <p class="promo-sub">Limited time: Free delivery on 2+ items. Grab your favorites before stock runs out!</p>
                    <div class="promo-actions">
                        <a href="/Home/Featured" class="btn btns btnPrimary">Shop Featured</a>
                        <a href="/Home/Collections" class="btn btnGhost btns">View Collection</a>
                    </div>
                </div>
                <div class="promo-media">
                    <img src="~/images/attar-crafting.jpg" alt="Promo" />
                </div>
            </div>
        </div>

        <div class="filterBar" role="region" aria-label="Category filters">
            <button type="button" class="filterChip is-active" data-category-id="">All</button>
            @foreach (var c in Model.Categories)
            {
                <button type="button"
                        class="filterChip @(Model.SelectedCategoryId == c.Id ? "is-active" : "")"
                        data-category-id="@c.Id">
                    @c.Name
                </button>
            }
        </div>

        <div class="filterBar subFilterBar" role="region" aria-label="Subcategory filters">
            <button type="button"
                    class="filterChip @(Model.SelectedSubCategoryId == null ? "is-active" : "")"
                    data-subcategory-id="">
                All subcategories
            </button>
            @foreach (var sc in Model.SubCategories)
            {
                <button type="button"
                        class="filterChip @(Model.SelectedSubCategoryId == sc.Id ? "is-active" : "")"
                        data-subcategory-id="@sc.Id">
                    @sc.Name
                </button>
            }
        </div>
        @await Html.PartialAsync("~/Views/Catalog/_ProductGrid.cshtml", Model.Products)
    </div>
</section>

    <style>
        .btns{
    width:48% !important;
        }
    </style>