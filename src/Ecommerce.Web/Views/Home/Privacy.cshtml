                                    </div>
                                </div>
                                <div class="rightItem">
                                    <span class="rightIcon">✏️</span>
                                    <div>
                                        <strong>Right to Rectification</strong>
                                        <p>Correct inaccurate or incomplete data</p>
                                    </div>
                                </div>
