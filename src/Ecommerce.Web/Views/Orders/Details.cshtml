@model Ecommerce.Web.ViewModels.OrderDetailViewModel
@{
    ViewData["Title"] = $"Order #{Model.Order.OrderId}";
    decimal subtotal = Model.Order.TotalAmount - Model.Order.DeliveryCharge;
}

<section class="page">
    <div class="container">
        <div class="orderSuccessMessage" style="background-color:#d4edda; color:#155724; padding:15px; border-radius:5px; margin-bottom:20px; border:1px solid #c3e6cb;">
            ✅ Your order has been successfully placed!
        </div>

        <div class="pageHeader">
            <h1 class="pageTitle">Order #@Model.Order.OrderId</h1>
        </div>

        <div class="panel">
            <div class="orderSummaryGrid">
                <div class="cartRow">
                    <span>Status</span>
                    <strong>@Model.Order.Status</strong>
                </div>
                <div class="cartRow">
                    <span>Payment</span>
                    <strong>COD <span style=" font-family: monospace;">(Cash on Delivery)</span></strong>
                </div>
                <div class="cartRow">
                    <span>Ordered Date</span>
                    <strong>@Model.Order.CreatedAt.ToString("d MMMM yyyy ")  </strong>
                </div>
                <div class="cartRow">
                    <span>Ordered Time</span>
                    <strong>@Model.Order.CreatedAt.ToString("h:mm tt")  </strong>
                </div>
            </div>
            <h2 class="panelTitle" style="margin-top:18px;">Items</h2>
            <div class="cartItems" style="padding:0;gap:10px;">
                @foreach (var item in Model.Order.Items)
                {
                    <div class="cartItem" style="grid-template-columns:72px 1fr;">
                        <img src="@item.ImageUrl" alt="@item.ProductName" />
                        <div>
                            <p class="cartItemTitle">@item.ProductName</p>
                            <div class="cartItemMeta">@item.Quantity x RS: @item.UnitPrice.ToString("0.00")</div>
                            <div class="cartItemMeta" style="margin-top:6px;color:var(--text);font-weight:800;">
                                RS: @item.LineTotal.ToString("0.00")
                            </div>
                        </div>
                    </div>
                }
            </div>


            <!-- Customer Information -->
            <div class="panel" style="margin-top:12px;">
                <h2 class="panelTitle" style="margin-bottom:10px;">Customer</h2>
                <div class="cartRow"><span>Name</span><strong>@Model.Order.FullName</strong></div>
                <div class="cartRow"><span>Phone</span><strong>@Model.Order.Phone</strong></div>
                @if (!string.IsNullOrWhiteSpace(Model.Order.Email))
                {
                    <div class="cartRow"><span>Email</span><strong>@Model.Order.Email</strong></div>
                }
                <div class="cartRow" style="align-items:flex-start;">
                    <span>Address</span>
                    <strong style="text-align:right;max-width:62%;">
                        @Model.Order.AddressLine1
                        @if (!string.IsNullOrWhiteSpace(Model.Order.AddressLine2))
                        {
                            <text><br />@Model.Order.AddressLine2</text>
                        }
                        <br />
                        @Model.Order.City - @Model.Order.ZipCode
                    </strong>
                </div>
            </div>
            <!-- Delivery Breakdown -->
            <div class="cartTotals" style="margin: 20px 0; padding: 12px; border-radius: 8px;">
                <div class="cartRow">
                    <span>Subtotal (Items)</span>
                    <strong>RS: @subtotal.ToString("0.00")</strong>
                </div>
                <div class="cartRow">
                    <span>Delivery Charges</span>
                    <strong style="color: @(Model.Order.DeliveryCharge == 0 ? "#28a745" : "white")">
                        @(Model.Order.DeliveryCharge == 0 ? "FREE" : $"RS: {Model.Order.DeliveryCharge.ToString("0.00")}")
                    </strong>
                </div>
                <div class="cartRow" style="font-size: 1.15em; font-weight: bold; border-top: 2px solid #374151; padding-top: 10px; margin-top: 8px;">
                    <span>Total Amount</span>
                    <strong>RS: @Model.Order.TotalAmount.ToString("0.00")</strong>
                </div>
            </div>
          
        </div>
    </div>
</section>