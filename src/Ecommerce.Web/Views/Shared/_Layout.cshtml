@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery

@{
    var csrf = Antiforgery.GetAndStoreTokens(Context);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Moon Essence</title>
    <meta name="csrf-token" content="@csrf.RequestToken" />
    <link rel="stylesheet" href="~/css/ecommerce.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />


    <style>
        .cartIcon::before {
            content: "🛒";
            font-size: 18px;
        }

        .whatsappBtn {
            position: fixed;
            bottom: 20px;
            right: 20px;
            width: 58px;
            height: 58px;
            background: #25D366;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            box-shadow: 0 6px 16px rgba(0,0,0,0.3);
            z-index: 999;
            transition: all 0.3s ease;
            animation: waPulse 2s infinite;
        }

        .waIcon {
            width: 28px;
            height: 28px;
            color: white;
        }

        .whatsappBtn:hover {
            transform: scale(1.15) rotate(5deg);
            box-shadow: 0 8px 22px rgba(0,0,0,0.4);
            background: #1ebe5d;
        }

        @@keyframes waPulse {
            0% {
                box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.7);
            }

            70% {
                box-shadow: 0 0 0 14px rgba(37, 211, 102, 0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(37, 211, 102, 0);
            }
        }
    </style>
</head>
<body data-authenticated="@(User?.Identity?.IsAuthenticated == true ? "true" : "false")">
    <div class="appShell">
        <header class="topNav">
            <div class="topNavInner">
                <button id="navToggle" class="iconBtn" type="button" aria-label="Open menu">
                    <span class="hamburger" aria-hidden="true"></span>
                </button>

                <a class="brand" style="display:flex;align-items: center;" href="/">
                    <img src="/images/moon.png" alt="logo" style="height:40px;" />
                    <span>Moon Essence</span>
                </a>
                <nav id="mobileNav" class="navPanel" aria-label="Primary navigation">
                    @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                    {
                        <a class="navLink" href="/Admin/Dashboard">Admin dashboard</a>
                        <a class="navLink" href="/Admin/Products">Products</a>
                        <a class="navLink" href="/Admin/Categories">Categories</a>
                        <a class="navLink" href="/Admin/SubCategories">Subcategories</a>
                        <a class="navLink" href="/Admin/Orders">Orders</a>
                        <form method="post" action="/Account/Logout" class="navForm">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="navLink navButton">Logout</button>
                        </form>
                    }
                    else
                    {
                        <!-- Regular user links -->
                        <a class="navLink" href="/">Shop</a>
                        <a class="navLink" href="/Orders/History">Order history</a>
                        <a class="navLink" href="/About">About Us</a>
                        <a class="navLink" href="/Privacy">Privacy Policy</a>
                        <a class="navLink" href="/Terms">Terms & Conditions</a>
                        <a class="navLink" href="/Contact">Contact Us</a>

                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            <form method="post" action="/Account/Logout" class="navForm">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="navLink navButton">Logout</button>
                            </form>
                        }
                        else
                        {
                            <a class="navLink" href="/Account/Login">Login</a>
                            <a class="navLink" href="/Account/Register">Register</a>
                        }
                    }
                </nav>

                <button id="cartToggle" class="cartBtn iconBtn" type="button" aria-label="Open cart">
                    <span class="cartIcon" aria-hidden="true"></span>
                    <span id="cartBadge" class="badge" aria-live="polite">0</span>
                </button>
            </div>
        </header>

        <div id="cartOverlay" class="overlay" hidden></div>
        <aside id="cartDrawer" class="cartDrawer" aria-label="Cart drawer" aria-hidden="true">
            <div class="cartHeader">
                <h2 class="cartTitle">Your cart</h2>
                <button id="cartClose" class="iconBtn" type="button" aria-label="Close cart">×</button>
            </div>

            <div class="cartBody">
                <div id="cartItems" class="cartItems"></div>
                <div class="cartTotals">
                    <div class="cartRow">
                        <span>Subtotal</span>
                        <strong id="cartSubtotal">0.00</strong>
                    </div>
                    <div class="cartRow">
                        <span>Total items</span>
                        <strong id="cartTotalItems">0</strong>
                    </div>
                </div>
            </div>

            <div class="cartFooter">
                <a id="checkoutBtn" class="btn btnPrimary" href="/Checkout">Checkout</a>
                <a class="btn btnGhost" href="/Orders/History">Order history</a>
            </div>
        </aside>

        <main class="main" role="main">
            @RenderBody()
        </main>

        @await Html.PartialAsync("_Footer")
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await Html.PartialAsync("~/Views/Shared/_ValidationScriptsPartial.cshtml")
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <a href="https://wa.me/923274574890?text=Hello%20I%20want%20to%20order"
       class="whatsappBtn"
       target="_blank"
       aria-label="Chat on WhatsApp">
        <svg class="waIcon" viewBox="0 0 32 32">
            <path fill="currentColor"
                  d="M19.11 17.56c-.29-.14-1.72-.85-1.98-.95-.26-.1-.45-.14-.64.14-.19.29-.74.95-.91 1.15-.17.19-.34.21-.63.07-.29-.14-1.24-.46-2.36-1.46-.87-.78-1.46-1.75-1.63-2.04-.17-.29-.02-.45.13-.59.13-.13.29-.34.43-.51.14-.17.19-.29.29-.48.1-.19.05-.36-.02-.51-.07-.14-.64-1.55-.88-2.12-.23-.55-.47-.48-.64-.49-.17-.01-.36-.01-.55-.01-.19 0-.51.07-.78.36-.27.29-1.03 1.01-1.03 2.47s1.06 2.87 1.21 3.07c.14.19 2.09 3.2 5.07 4.48.71.31 1.26.5 1.69.64.71.23 1.36.2 1.87.12.57-.08 1.72-.7 1.96-1.38.24-.68.24-1.26.17-1.38-.07-.12-.26-.19-.55-.33zM16.01 3C8.83 3 3 8.83 3 16c0 2.82.92 5.43 2.48 7.56L3 29l5.59-2.45A12.94 12.94 0 0016.01 29C23.17 29 29 23.17 29 16S23.17 3 16.01 3zm0 23.6c-2.37 0-4.56-.74-6.36-2.01l-.45-.32-3.32 1.45.71-3.43-.29-.44A10.57 10.57 0 015.4 16c0-5.84 4.75-10.6 10.6-10.6 5.84 0 10.6 4.76 10.6 10.6s-4.76 10.6-10.6 10.6z" />
        </svg>
    </a>
    <script>
        // Mobile Menu Toggle Functionality
        document.addEventListener('DOMContentLoaded', function() {
            const navToggle = document.getElementById('navToggle');
            const mobileNav = document.getElementById('mobileNav');
            const cartToggle = document.getElementById('cartToggle');
            const cartDrawer = document.getElementById('cartDrawer');
            const cartOverlay = document.getElementById('cartOverlay');
            const cartClose = document.getElementById('cartClose');

            // Mobile Menu Toggle - FIXED
            if (navToggle && mobileNav) {
                navToggle.addEventListener('click', function(e) {
                    e.stopPropagation();
                    mobileNav.classList.toggle('active');
                    this.classList.toggle('active');

                    // Toggle body class for overlay
                    if (mobileNav.classList.contains('active')) {
                        document.body.classList.add('menu-open');
                    } else {
                        document.body.classList.remove('menu-open');
                    }
                });

                // Close menu ONLY when clicking on overlay background
                document.body.addEventListener('click', function(event) {
                    if (mobileNav.classList.contains('active')) {
                        // Don't close if clicking on menu or toggle button
                        if (!mobileNav.contains(event.target) && !navToggle.contains(event.target)) {
                            mobileNav.classList.remove('active');
                            navToggle.classList.remove('active');
                            document.body.classList.remove('menu-open');
                        }
                    }
                });

                // Close menu when clicking a link (but prevent immediate closing issues)
                const navLinks = mobileNav.querySelectorAll('.navLink');
                navLinks.forEach(link => {
                    link.addEventListener('click', function(e) {
                        // Don't close if it's a form button
                        if (this.tagName === 'BUTTON' || this.classList.contains('navButton')) {
                            return;
                        }
                        mobileNav.classList.remove('active');
                        navToggle.classList.remove('active');
                        document.body.classList.remove('menu-open');
                    });
                });
            }

            // Cart Toggle Functionality (unchanged)
            if (cartToggle && cartDrawer && cartOverlay) {
                cartToggle.addEventListener('click', function() {
                    cartDrawer.classList.add('open');
                    cartOverlay.hidden = false;
                    document.body.style.overflow = 'hidden';
                    cartDrawer.setAttribute('aria-hidden', 'false');
                });

                function closeCart() {
                    cartDrawer.classList.remove('open');
                    cartOverlay.hidden = true;
                    document.body.style.overflow = '';
                    cartDrawer.setAttribute('aria-hidden', 'true');
                }

                if (cartClose) {
                    cartClose.addEventListener('click', closeCart);
                }

                cartOverlay.addEventListener('click', closeCart);

                document.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape' && cartDrawer.classList.contains('open')) {
                        closeCart();
                    }
                });
            }

            console.log("Mobile menu and cart functionality initialized");
        });
    </script>
</body>

</html>

