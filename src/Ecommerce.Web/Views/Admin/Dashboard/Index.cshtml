@model Ecommerce.Web.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<section class="page">
    <div class="container">
        <div class="pageHeader">
            <div class="headerLeft">
                <h1 class="pageTitle">Admin Dashboard</h1>
                <p class="pageSubtitle">Real-time order monitoring & management</p>
            </div>
            <div class="headerRight">
                <div class="lastUpdate">
                    <i class="fas fa-clock"></i>
                    <span id="lastUpdateTime">Last updated: @DateTime.Now.ToString("hh:mm tt")</span>
                </div>
            </div>
        </div>

        <div class="adminStats">
            <div style="display:flex">
                <div class="statCard">
                    <div class="statIcon">
                        <i class="fas fa-box"></i>
                    </div>
                    <div class="statInfo">
                        <div class="statValue">@Model.Stats.TotalProducts</div>
                        <div class="statLabel">Total Products</div>
                    </div>
                </div>
                <div class="statCard">
                    <div class="statIcon">
                        <i class="fas fa-tags"></i>
                    </div>
                    <div class="statInfo">
                        <div class="statValue">@Model.Stats.TotalCategories</div>
                        <div class="statLabel">Categories</div>
                    </div>
               </div>
            </div> 
            <div style="display:flex">
            <div class="statCard">
                <div class="statIcon">
                    <i class="fas fa-shopping-cart"></i>
                </div>
                <div class="statInfo">
                    <div class="statValue">@Model.Stats.TotalOrders</div>
                    <div class="statLabel">Total Orders</div>
                </div>
            </div>
            <div class="statCard">
                <div class="statIcon">
                    <i class="fas fa-calendar-day"></i>
                </div>
                <div class="statInfo">
                    <div class="statValue">@Model.Stats.NewOrdersToday</div>
                    <div class="statLabel">New Today</div>
                </div>
            </div>
            </div>
            @if (Model.Stats.PendingOrders > 0)
            {
                <div class="statCard pending">
                    <div class="statIcon">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div class="statInfo">
                        <div class="statValue">@Model.Stats.PendingOrders</div>
                        <div class="statLabel">Pending Orders</div>
                    </div>
                </div>
            }
        </div>

        <div class="dashboardGrid">
            <div class="panel">
                <div class="panelHeader">
                    <div class="panelTitleWrapper">
                        <i class="fas fa-bell"></i>
                        <h2 class="panelTitle">New Orders</h2>
                        <span class="badge" id="orderCount">0</span>
                    </div>
                    
                </div>
                <div id="newOrders" class="newOrdersList">
                    <div class="emptyState">
                        <i class="fas fa-inbox"></i>
                        <p>Waiting for new orders...</p>
                        <span>Orders will appear here in real-time</span>
                    </div>
                </div>
            </div>

            <div class="panel">
                <div class="panelHeader">
                    <div class="panelTitleWrapper">
                        <i class="fas fa-chart-line"></i>
                        <h2 class="panelTitle">Quick Actions</h2>
                    </div>
                </div>
                <div class="quickActions">
                    <a href="/Admin/Products" class="actionCard">
                        <i class="fas fa-box"></i>
                        <span>Manage Products</span>
                    </a>
                    <a href="/Admin/Categories" class="actionCard">
                        <i class="fas fa-tags"></i>
                        <span>Manage Categories</span>
                    </a>
                    <a href="/Admin/Orders" class="actionCard">
                        <i class="fas fa-shopping-cart"></i>
                        <span>View All Orders</span>
                    </a>
                    <a href="/Admin/Users" class="actionCard">
                        <i class="fas fa-users"></i>
                        <span>Manage Users</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .page {
        background: #0a0a0a;
        min-height: 100vh;
        padding: 2rem;
    }

    .container {
        max-width: 1400px;
        margin: 0 auto;
    }

    /* Page Header */
    .pageHeader {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 2rem;
        padding: 1.5rem;
        background: #111111;
        border-radius: 20px;
        border: 1px solid rgba(212, 175, 55, 0.15);
    }

    .pageTitle {
        font-size: 1.8rem;
        font-weight: 600;
        background: linear-gradient(135deg, #ffffff 0%, #d4af37 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 0.5rem;
    }

    .pageSubtitle {
        color: #888888;
        font-size: 0.9rem;
    }

    .lastUpdate {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #888888;
        font-size: 0.85rem;
        background: #1a1a1a;
        padding: 0.5rem 1rem;
        border-radius: 10px;
    }

        .lastUpdate i {
            color: #d4af37;
        }

    /* Stats Cards */
    .adminStats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .statCard {
        background: #111111;
        border-radius: 20px;
        padding: 1.5rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        border: 1px solid rgba(212, 175, 55, 0.15);
        transition: all 0.3s ease;
    }

        .statCard:hover {
            transform: translateY(-5px);
            border-color: rgba(212, 175, 55, 0.3);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
        }

        .statCard.pending {
            border-color: rgba(220, 53, 69, 0.3);
        }

            .statCard.pending .statIcon {
                background: rgba(220, 53, 69, 0.1);
            }

            .statCard.pending .statValue {
                color: #dc3545;
            }

    .statIcon {
        width: 60px;
        height: 60px;
        background: rgba(212, 175, 55, 0.1);
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .statIcon i {
            font-size: 2rem;
            color: #d4af37;
        }

    .statCard.pending .statIcon i {
        color: #dc3545;
    }

    .statInfo {
        flex: 1;
    }

    .statValue {
        font-size: 2rem;
        font-weight: bold;
        color: #d4af37;
        line-height: 1;
        margin-bottom: 0.5rem;
    }

    .statLabel {
        color: #888888;
        font-size: 0.85rem;
    }

    /* Dashboard Grid */
    .dashboardGrid {
        display: grid;
        grid-template-columns: 1fr 400px;
        gap: 1.5rem;
    }

    /* Panel Styles */
    .panel {
        background: #111111;
        border-radius: 20px;
        border: 1px solid rgba(212, 175, 55, 0.15);
        overflow: hidden;
        transition: all 0.3s ease;
    }

        .panel:hover {
            border-color: rgba(212, 175, 55, 0.3);
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.3);
        }

    .panelHeader {
        background: #0c0c0c;
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid rgba(212, 175, 55, 0.1);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .panelTitleWrapper {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

        .panelTitleWrapper i {
            color: #d4af37;
            font-size: 1.3rem;
        }

    .panelTitle {
        font-size: 1.3rem;
        font-weight: 600;
        color: #ffffff;
        margin: 0;
    }

    .badge {
        background: rgba(212, 175, 55, 0.2);
        color: #d4af37;
        padding: 0.25rem 0.6rem;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 600;
        border: 1px solid rgba(212, 175, 55, 0.3);
    }

    .panelActions {
        display: flex;
        gap: 0.5rem;
    }

    .refreshBtn, .clearBtn {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #888888;
        width: 32px;
        height: 32px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .refreshBtn:hover {
            background: rgba(212, 175, 55, 0.1);
            border-color: #d4af37;
            color: #d4af37;
            transform: rotate(180deg);
        }

        .clearBtn:hover {
            background: rgba(220, 53, 69, 0.1);
            border-color: #dc3545;
            color: #dc3545;
        }

    /* Orders List */
    .newOrdersList {
        max-height: 500px;
        overflow-y: auto;
        padding: 0.5rem;
    }

    /* Empty State */
    .emptyState {
        text-align: center;
        padding: 3rem 2rem;
        color: #666666;
    }

        .emptyState i {
            font-size: 3rem;
            color: #2a2a2a;
            margin-bottom: 1rem;
            display: block;
        }

        .emptyState p {
            font-size: 1rem;
            color: #888888;
            margin-bottom: 0.5rem;
        }

        .emptyState span {
            font-size: 0.85rem;
            color: #555555;
        }

    /* Order Notification Card */
    .orderNotification {
        background: #1a1a1a;
        border-left: 3px solid #d4af37;
        border-radius: 12px;
        padding: 1rem;
        margin-bottom: 0.75rem;
        transition: all 0.3s ease;
        animation: slideInRight 0.3s ease-out;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

        .orderNotification:hover {
            background: #1f1f1f;
            transform: translateX(5px);
            border-left-color: #ffd700;
        }

    .orderInfo {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        flex: 1;
    }

    .orderId {
        background: rgba(212, 175, 55, 0.15);
        color: #d4af37;
        padding: 0.25rem 0.75rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.85rem;
        font-family: monospace;
    }

    .orderAmount {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #ffffff;
        font-weight: 500;
        font-size: 1rem;
    }

        .orderAmount i {
            color: #d4af37;
            font-size: 0.9rem;
        }

    .orderDate {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #888888;
        font-size: 0.8rem;
    }

        .orderDate i {
            color: #666666;
            font-size: 0.75rem;
        }

    .orderActions {
        display: flex;
        gap: 0.5rem;
    }

    .viewBtn {
        background: rgba(212, 175, 55, 0.1);
        border: 1px solid rgba(212, 175, 55, 0.3);
        color: #d4af37;
        padding: 0.35rem 0.75rem;
        border-radius: 6px;
        font-size: 0.75rem;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

        .viewBtn:hover {
            background: rgba(212, 175, 55, 0.2);
            transform: translateY(-2px);
        }

    .dismissBtn {
        background: rgba(220, 53, 69, 0.1);
        border: 1px solid rgba(220, 53, 69, 0.3);
        color: #dc3545;
        padding: 0.35rem 0.75rem;
        border-radius: 6px;
        font-size: 0.75rem;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

        .dismissBtn:hover {
            background: rgba(220, 53, 69, 0.2);
            transform: translateY(-2px);
        }

    /* Quick Actions */
    .quickActions {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.75rem;
        padding: 1rem;
    }

    .actionCard {
        background: #1a1a1a;
        border-radius: 12px;
        padding: 1rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        text-decoration: none;
        transition: all 0.3s ease;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

        .actionCard:hover {
            background: #1f1f1f;
            transform: translateX(5px);
            border-color: rgba(212, 175, 55, 0.3);
        }

        .actionCard i {
            font-size: 1.5rem;
            color: #d4af37;
        }

        .actionCard span {
            color: #ffffff;
            font-size: 0.95rem;
            font-weight: 500;
        }

    /* Scrollbar */
    .newOrdersList::-webkit-scrollbar {
        width: 6px;
    }

    .newOrdersList::-webkit-scrollbar-track {
        background: #0f0f0f;
        border-radius: 10px;
    }

    .newOrdersList::-webkit-scrollbar-thumb {
        background: #2a2a2a;
        border-radius: 10px;
    }

        .newOrdersList::-webkit-scrollbar-thumb:hover {
            background: #d4af37;
        }

    /* Animations */
    @@keyframes slideInRight {
        from

    {
        opacity: 0;
        transform: translateX(-30px);
    }

    to {
        opacity: 1;
        transform: translateX(0);
    }

    }

    @@keyframes fadeOut {
        from

    {
        opacity: 1;
        transform: translateX(0);
    }

    to {
        opacity: 0;
        transform: translateX(30px);
    }

    }

    .orderNotification.removing {
        animation: fadeOut 0.3s ease-out forwards;
    }

    @@keyframes pulse {
        0%

    {
        transform: scale(1);
        opacity: 1;
    }

    50% {
        transform: scale(1.1);
        opacity: 0.8;
    }

    100% {
        transform: scale(1);
        opacity: 1;
    }

    }

    .badge.hasNew {
        animation: pulse 0.5s ease-in-out;
        background: rgba(212, 175, 55, 0.3);
    }

    /* Responsive */
    @@media (max-width: 1024px) {
        .dashboardGrid

    {
        grid-template-columns: 1fr;
    }

    }

    @@media (max-width: 768px) {
        .page

    {
        padding: 1rem;
    }

    .adminStats {
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
    }

    .statCard {
        padding: 1rem;
    }

    .statIcon {
        width: 50px;
        height: 50px;
    }

        .statIcon i {
            font-size: 1.5rem;
        }

    .statValue {
        font-size: 1.5rem;
    }

    .panelHeader {
        padding: 1rem;
    }

    .panelTitle {
        font-size: 1.1rem;
    }

    .orderNotification {
        flex-direction: column;
        align-items: stretch;
    }

    .orderInfo {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
    }

    .orderActions {
        justify-content: flex-end;
        margin-top: 0.5rem;
    }

    }
</style>

<script src="https://kit.fontawesome.com/your-fontawesome-kit.js"></script>
<script src="~/lib/signalr/dist/browser/signalr.min.js"></script>
<script>
    // Update order count badge
    function updateOrderCount() {
        const orders = document.querySelectorAll('.orderNotification:not(.removing)');
        const count = orders.length;
        const badge = document.getElementById('orderCount');

        if (badge) {
            badge.textContent = count;
            if (count > 0) {
                badge.classList.add('hasNew');
                setTimeout(() => badge.classList.remove('hasNew'), 500);
            }
        }

        const newOrders = document.getElementById('newOrders');
        const emptyState = newOrders?.querySelector('.emptyState');
        if (count === 0 && emptyState) {
            emptyState.style.display = 'block';
        } else if (emptyState) {
            emptyState.style.display = 'none';
        }
    }

    function dismissOrder(element) {
        const orderDiv = element.closest('.orderNotification');
        orderDiv.classList.add('removing');
        setTimeout(() => {
            orderDiv.remove();
            updateOrderCount();
        }, 300);
    }

  
   

    function viewOrder(orderId) {
        window.location.href = `/Admin/Orders/Details/${orderId}`;
    }

    // SignalR Connection
    document.addEventListener('DOMContentLoaded', function () {
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/order")
            .withAutomaticReconnect()
            .build();

        connection.on("orderPlaced", function (order) {
            const newOrders = document.getElementById("newOrders");
            const emptyState = newOrders?.querySelector('.emptyState');
            if (emptyState) {
                emptyState.style.display = 'none';
            }

            const div = document.createElement("div");
            div.className = "orderNotification";
            div.innerHTML = `
                <div class="orderInfo">
                    <div class="orderId">
                        <i class="fas fa-hashtag"></i>
                        ${order.orderId}
                    </div>
                    <div class="orderAmount">
                        <i class="fas fa-rupee-sign"></i>
                        ${parseFloat(order.totalAmount).toFixed(2)}
                    </div>
                    <div class="orderDate">
                        <i class="fas fa-calendar-alt"></i>
                        ${new Date(order.createdAt).toLocaleString()}
                    </div>
                </div>
                <div class="orderActions">
                    <button class="viewBtn" onclick="viewOrder(${order.orderId})">
                        <i class="fas fa-eye"></i>
                        View
                    </button>
                   
                </div>
            `;

            newOrders.prepend(div);
            updateOrderCount();
        });

        connection.start().catch(function (err) {
            console.error("SignalR connection error:", err.toString());
        });

        updateOrderCount();
    });
</script>