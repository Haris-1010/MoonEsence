@model Ecommerce.Web.ViewModels.AdminProductsIndexViewModel
@{
    ViewData["Title"] = "Manage products";
}

<section class="page">
    <div class="container">
        @if (TempData["ProductSuccess"] != null)
        {
            <div id="productToast" class="product-toast success">
                <span>@TempData["ProductSuccess"]</span>
                <button type="button" id="productToastClose" aria-label="Close">&times;</button>
            </div>
        }
        <div class="pageHeader">
            <h1 class="pageTitle">Products</h1>
            <p class="pageSubtitle">Admin</p>
        </div>

        <form method="get" action="/Admin/Products" class="form filterForm">
            <div class="formField">
                <label>Search</label>
                <input name="search" value="@Model.Search" class="input" />
            </div>
            <div class="formField">
                <label>CategoryId</label>
                <input name="categoryId" value="@Model.CategoryId" class="input" />
            </div>
            <button type="submit" class="btn btnPrimary">Filter</button>
            <a class="btn btnGhost" href="/Admin/Products/Create">+ Add</a>
            <br />
        </form>

        @if (Model.Products.Items.Count == 0)
        {
            <div class="emptyState" style="padding:12px;color:rgba(229,231,235,.8)">No products found.</div>
        }
        else
        {<h1>All Products</h1>
            <div class="ordersList">
                @foreach (var p in Model.Products.Items)
                {
                    <div class="orderCard">
                        <div class="orderCardRow">
                            <strong>@p.Name</strong>
                            <span class="muted">Rs: @p.Price.ToString("0.00")</span>
                        </div>
                        <div class="orderCardRow">
                            <span class="muted">Category</span>
                            <strong>@p.CategoryName</strong>
                        </div>
                        <div class="btns">
                            <a class="btn btnPrimary editbtn" href="/Admin/Products/Edit/@p.Id">Edit</a>
                            <form method="post" action="/Admin/Products/Delete/@p.Id" onsubmit="return confirm('Delete product?')" style="margin:0;width: 48%;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btnGhost">Delete</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

<style>
    .btns{
        display:flex;
        justify-content:space-between
    }

    .editbtn {
        width: 48% !important
        ;
    }
    .btnGhost {
        width: 100% !important;
    }
 
</style>


<style>
    .product-toast {
        position: fixed;
        top: 30px;
        right: 30px;
        z-index: 2000;
        padding: 14px 22px;
        border-radius: 8px;
        color: #fff;
        background: #10b981;
        box-shadow: 0 6px 18px rgba(0,0,0,0.35);
        display: flex;
        align-items: center;
        gap: 14px;
        font-size: 1rem;
        animation: fadeIn .3s;
    }

        .product-toast button {
            background: transparent;
            border: none;
            color: rgba(255,255,255,0.9);
            font-size: 22px;
            line-height: 1;
            cursor: pointer;
            margin-left: 10px;
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
<script>
    (function () {
        const toast = document.getElementById('productToast');
        if (!toast) return;
        const closeBtn = document.getElementById('productToastClose');
        function hide() {
            toast.style.opacity = '0';
            setTimeout(() => toast.remove(), 300);
        }
        setTimeout(hide, 3500);
        closeBtn?.addEventListener('click', hide);
    })();
</script>