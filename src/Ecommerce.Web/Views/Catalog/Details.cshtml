@model Ecommerce.Web.ViewModels.ProductDetailViewModel
@{
    ViewData["Title"] = Model.Product.Name;
}

<section class="page">
    <div class="container">
         
        <div class="productDetail">
            <div class="productDetailMedia">
                <img src="@Model.Product.ImageUrl" alt="@Model.Product.Name" loading="lazy" />
            </div>
            <div class="productDetailInfo">
                <h1 class="productDetailTitle">@Model.Product.Name</h1>

                @* Pricing *@
                @{
                    decimal regularPrice = Model.Product.RegularPrice;
                    decimal salePrice = Model.Product.Price;
                    decimal discount = regularPrice - salePrice;
                }
                <div class="productDetailPrice">
                    <span class="regularPrice" style="text-decoration: line-through;font-weight:500; color:#888; font-size:0.9em;">
                        Rs.@regularPrice.ToString("N2")
                    </span>
                    <span class="salePrice" style="font-weight:500; margin-left:8px; font-size:1.2em;">
                        Rs.@salePrice.ToString("N2")
                    </span>

                </div>

                <div class="productDetailCategory">Category: @Model.Product.CategoryName</div>
            

                <div class="productDetailActions">
                    <button type="button"
                            class="btn btnPrimary addToCartBtn"
                            data-product-id="@Model.Product.Id"
                            data-qty="1">
                        Add to cart
                    </button>
                    <button type="button"
                            class="btn btnGhost buyNowBtn"
                            data-product-id="@Model.Product.Id"
                            data-qty="1">
                        Buy now
                    </button>
                </div>
                <div class="productDetailDescription">
                    @Html.Raw(Model.Product.Description)
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* Product Detail Actions - 50% width buttons with margin top */
    .productDetailActions {
        display: flex;
        gap: 12px;
        margin-top: 2%;
        width: 100%;
    }

        .productDetailActions .btn {
            flex: 1;
            text-align: center;
            padding: 12px 16px;
            font-weight: 600;
            font-size: 14px;
            transition: all 0.3s ease;
        }

        .productDetailActions .btnPrimary {
            background: rgba(34, 197, 94, 0.18);
            border-color: rgba(34, 197, 94, 0.55);
            color: #bff5cf;
        }

            .productDetailActions .btnPrimary:hover {
                background: rgba(34, 197, 94, 0.3);
                transform: translateY(-2px);
            }

        .productDetailActions .btnGhost {
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(255, 255, 255, 0.2);
            color: #e5e7eb;
        }

            .productDetailActions .btnGhost:hover {
                background: rgba(255, 255, 255, 0.1);
                transform: translateY(-2px);
            }

    /* Mobile optimization */
    @@media (max-width: 768px) {
        .productDetailActions

    {
        gap: 10px;
        margin-top: 16px;
    }

    .productDetailActions .btn {
        padding: 10px 12px;
        font-size: 13px;
    }

    }

    /* Very small screens */
    @@media (max-width: 480px) {
        .productDetailActions

    {
        gap: 8px;
        margin-top: 14px;
    }

    .productDetailActions .btn {
        padding: 8px 10px;
        font-size: 12px;
    }

    }
</style>