@model Ecommerce.Web.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
}

<section class="page">
    <div class="container">
        <h1 class="pageTitle">Checkout</h1>

        <div class="panel">
            <h2 class="panelTitle">Your items</h2>
            @if (Model.Cart.Lines.Count == 0)
            {
                <div class="emptyState">Your cart is empty.</div>
            }
            else
            {
                <div class="cartItems" style="padding:0;gap:10px;">
                    @foreach (var line in Model.Cart.Lines)
                    {
                        <div class="cartItem" style="grid-template-columns:64px 1fr;">
                            <img src="@line.ImageUrl" alt="@line.ProductName" />
                            <div>
                                <p class="cartItemTitle">@line.ProductName</p>
                                <div class="cartItemMeta">@line.Quantity x $@line.UnitPrice</div>
                                <div class="cartItemMeta" style="margin-top:6px;color:var(--text);font-weight:800;">$@line.LineTotal</div>
                            </div>
                        </div>
                    }
                </div>
                <div class="cartTotals" style="margin-top:12px;">
                    <div class="cartRow">
                        <span>Subtotal</span>
                        <strong>@Model.Cart.Subtotal.ToString("0.00")</strong>
                    </div>
                    <div class="cartRow">
                        <span>Total items</span>
                        <strong>@Model.Cart.TotalItems</strong>
                    </div>
                </div>
            }
        </div>

        <form method="post" action="/Checkout" class="form">
            @Html.AntiForgeryToken()
            <h2 class="panelTitle" style="margin-top:16px;">Delivery details</h2>

            <div class="formField">
                <label asp-for="Checkout.FullName"></label>
                <input asp-for="Checkout.FullName" class="input" />
                <span asp-validation-for="Checkout.FullName" class="fieldError"></span>
            </div>

            <div class="formField">
                <label asp-for="Checkout.Phone"></label>
                <input asp-for="Checkout.Phone" class="input" />
                <span asp-validation-for="Checkout.Phone" class="fieldError"></span>
            </div>

            <div class="formField">
                <label asp-for="Checkout.Email"></label>
                <input asp-for="Checkout.Email" class="input" />
                <span asp-validation-for="Checkout.Email" class="fieldError"></span>
            </div>

            <div class="formField">
                <label asp-for="Checkout.City"></label>
                <input asp-for="Checkout.City" class="input" list="citiesList" />
                <datalist id="citiesList">
                    <option value="Karachi"></option>
                    <option value="Lahore"></option>
                    <option value="Islamabad"></option>
                    <option value="Rawalpindi"></option>
                    <option value="Faisalabad"></option>
                    <option value="Multan"></option>
                </datalist>
                <span asp-validation-for="Checkout.City" class="fieldError"></span>
            </div>

            <div class="formField">
                <label asp-for="Checkout.AddressLine1">Address</label>
                <input asp-for="Checkout.AddressLine1" class="input" />
                <span asp-validation-for="Checkout.AddressLine1" class="fieldError"></span>
            </div>
            <div class="formField">
                <label asp-for="Checkout.AddressLine2">Address line 2 (optional)</label>
                <input asp-for="Checkout.AddressLine2" class="input" placeholder="Apartment, flat, house no, etc." />
                <span asp-validation-for="Checkout.AddressLine2" class="fieldError"></span>
            </div>

            <div class="formField">
                <label asp-for="Checkout.ZipCode">Postal Code (optional)</label>
                <input asp-for="Checkout.ZipCode" class="input" />
                <span asp-validation-for="Checkout.ZipCode" class="fieldError"></span>
            </div>

            <div class="panel" style="margin-top:6px;">
                <div class="cartRow" style="margin:0;">
                    <span>Payment</span>
                    <strong>COD (Cash on Delivery)</strong>
                </div>
            </div>

            <button type="submit" class="btn btnPrimary" style="margin-top:14px;">Place order</button>
        </form>
    </div>
</section>

